# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
venv*/
.venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
._*

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Training artifacts
session_*/
rollouts/
final_states/
screenshots/

# Model checkpoints & weights (large binary files)
*.zip
*.pth

# Save states (large binary emulator snapshots)
# Keep only the base initialization states tracked via explicit git add
*.state

# TensorBoard / training run logs
runs/

# Photoshop / design source files
*.psd

# Runtime flags (generated at runtime, not source code)
agent_enabled.txt
delete_empty_imgs.txt

# Emulator / game artifacts
*.ram
*.sav
*.sgm
_autoplay.mp4

# ROM files (user must supply their own)
ROM_INPUT/*.gb
ROM_INPUT/*.gbc

# Logs and data
*.log
*.csv.gz
wandb/

# Secrets / config
.env
*.pem

# Misc
raw_documentation/
